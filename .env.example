# Copy to .env and set a real password: cp .env.example .env
# .env is git-ignored — never commit it.
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# App connection string (used from task 02 onward)
DATABASE_URL=postgresql://blog:change-me@localhost:5432/blog

# Payload admin secret (generate: openssl rand -hex 32)
PAYLOAD_SECRET=
